# Копирај во .env и пополни
# За Docker со постоечки db контејнер: DB_HOST=klinicka_bolnica_db_1
# За Docker со наш mysql сервис: DB_HOST=mysql
# За локално: DB_HOST=localhost
#
# На сервер со docker-compose: истата лозинка мора за MySQL root и за backend.
# Додај MYSQL_ROOT_PASSWORD (иста како DB_PASSWORD) или на коренот на проектот креирај .env
# со DB_PASSWORD=... за compose, или: ln -sf backend/.env .env

DB_HOST=mysql
DB_USER=root
DB_PASSWORD=rootpassword
MYSQL_ROOT_PASSWORD=rootpassword
DB_NAME=Klinicka_Bolnica_Stip
DB_PORT=3306
