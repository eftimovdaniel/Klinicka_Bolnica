# Копирај во .env и пополни (backend/.env се вчитува директно во Docker — без презапишување од корен .env)
#
# За Docker со mysql контејнер: DB_HOST=mysql
# За Azure Database for MySQL: DB_HOST=име.mysql.database.azure.com и DB_SSL=1
# За локално: DB_HOST=localhost
#
# MYSQL_ROOT_PASSWORD само ако го користиш mysql сервисот во compose (иста како DB_PASSWORD).

DB_HOST=mysql
DB_USER=root
DB_PASSWORD=rootpassword
MYSQL_ROOT_PASSWORD=rootpassword
DB_NAME=Klinicka_Bolnica_Stip
DB_PORT=3306

# Google AI Studio (единствен LLM provider)
LLM_PROVIDER=google
GOOGLE_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY_HERE
GOOGLE_MODEL=gemini-1.5-flash
GOOGLE_TIMEOUT_SECONDS=45

# Azure MySQL (остави празно за локален Docker без SSL)
# DB_SSL=1
# DB_SSL_MODE=required
# DB_SSL_VERIFY=false
# DB_SSL_CA=/пат/до/ca.pem

# Опционално – слики за новости во Azure Blob (без ова апликацијата користи локален static/uploads/novosti)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_CONTAINER_NAME=
