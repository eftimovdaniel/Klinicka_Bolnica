# Копирај во .env и пополни (backend/.env се вчитува директно во Docker — без презапишување од корен .env)
#
# За Docker со mysql контејнер: DB_HOST=mysql
# За Azure Database for MySQL: DB_HOST=име.mysql.database.azure.com и DB_SSL=1
# За локално: DB_HOST=localhost
#
# MYSQL_ROOT_PASSWORD само ако го користиш mysql сервисот во compose (иста како DB_PASSWORD).

DB_HOST=mysql
DB_USER=root
DB_PASSWORD=rootpassword
MYSQL_ROOT_PASSWORD=rootpassword
DB_NAME=Klinicka_Bolnica_Stip
DB_PORT=3306

# Groq — https://console.groq.com/ (free tier има лимит по минута / 429)
# GROQ_MODEL / FALLBACK се официјални идентификатори на модели кај Groq (не Ollama).
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant
# GROQ_FAST_ONLY=1          # само полесен модел (повеќе барања, помалку 429)
# GROQ_DISABLED=1           # секогаш без Groq (испит/demo)
# GROQ_AUTO_OFFLINE=1       # default: по 429 → локален режим (правила + MySQL)
# GROQ_OFFLINE_COOLDOWN_SEC=600   # колку секунди без Groq по 429 (default 10 min)

# Azure MySQL (остави празно за локален Docker без SSL)
# DB_SSL=1
# DB_SSL_MODE=required
# DB_SSL_VERIFY=false
# DB_SSL_CA=/пат/до/ca.pem

# SMTP – вистинска е-пошта за потврда по закажан термин (без ова се печати само во терминал)
# Gmail: 2FA + App Password на https://myaccount.google.com/apppasswords
# Погледни backend/SMTP_SETUP.md
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tvoj.email@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM=tvoj.email@gmail.com

# Опционално – слики за новости во Azure Blob (без ова апликацијата користи локален static/uploads/novosti)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_CONTAINER_NAME=
