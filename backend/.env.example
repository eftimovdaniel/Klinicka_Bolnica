# Копирај во .env и пополни (backend/.env се вчитува директно во Docker — без презапишување од корен .env)
#
# За Docker со mysql контејнер: DB_HOST=mysql
# За Azure Database for MySQL: DB_HOST=име.mysql.database.azure.com и DB_SSL=1
# За локално: DB_HOST=localhost
#
# MYSQL_ROOT_PASSWORD само ако го користиш mysql сервисот во compose (иста како DB_PASSWORD).

DB_HOST=mysql
DB_USER=root
DB_PASSWORD=rootpassword
MYSQL_ROOT_PASSWORD=rootpassword
DB_NAME=Klinicka_Bolnica_Stip
DB_PORT=3306

# Groq AI (единствен LLM provider - Llama 3.3 70B)
# Регистрирај се бесплатно на https://console.groq.com/ и земи клуч.
GROQ_API_KEY=gsk_your_key_here
# Опционално - модел (стандард: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Azure MySQL (остави празно за локален Docker без SSL)
# DB_SSL=1
# DB_SSL_MODE=required
# DB_SSL_VERIFY=false
# DB_SSL_CA=/пат/до/ca.pem

# Опционално – слики за новости во Azure Blob (без ова апликацијата користи локален static/uploads/novosti)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_CONTAINER_NAME=

# Facebook Page → новости (Meta Graph API) — директор одобрува пред објава
# Страница: https://www.facebook.com/profile.php?id=61573825102800
# FB_SYNC_MOCK=0
# FB_PAGE_ID=61573825102800
# или: FB_PAGE_URL=https://www.facebook.com/profile.php?id=61573825102800
# FB_PAGE_ACCESS_TOKEN=   (од admin на страницата / Meta Developer)
# FB_API_VERSION=v21.0
# FB_SYNC_INTERVAL_MINUTES=30
# FB_SYNC_LIMIT=5
# FB_SYNC_SINCE_DAYS=7
# FB_SYNC_MAX_NEW_PER_RUN=1
# FB_SYNC_MOCK=1
